# Khoá Google Gemini (bắt buộc) — lấy tại Google AI Studio. Không commit file .env.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính quá tải (cách nhau dấu phẩy)
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Địa chỉ công khai của trang, dùng cho sitemap, canonical, ảnh chia sẻ (Open Graph)
# SITE_URL=https://petsight.example
# PORT=3000
# TRUST_PROXY=1
# Dự phòng: chỉ dùng Claude khi không có GEMINI_API_KEY
# ANTHROPIC_API_KEY=
