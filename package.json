{
  "name": "petsight-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PetSight AI — trang web và API trong một server Express",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tailwindcss -i src/styles.css -o public/build.css --minify",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5"
  }
}
